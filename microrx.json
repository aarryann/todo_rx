{
  "outDir": "dist",
  "pagesDir": "src",
  "route": {
    "manifest": "pages.json"
  },
  "state": {
    "outDir": "state",
    "publicPath": "/__mrx_state__"
  },
  "server": {
    "port": 3000,
    "host": "localhost",
    "adapter": "express",
    "manifest": "server.json"
  },
  "ignore": [
    "index.html",
    "board/profile.html",
    "todo/todo.html",
    "board/ignore-index.html",
    "jira/ignore_index1.html"
  ],
  "assets": [
    { ".": [ "node_modules/microrx/dist/csr/microrx@0.3.js", "node_modules/microrx/dist/csr/app.js" ] },
    { "data": [ "src/data/todos.json", "src/data/board.json" ] },
    { "board": [ "src/board/data.json" ] },
    { "jira": [ "src/board/data.json" ] }
  ],
  "sharedComponentPaths":[
    "./src/components"
  ]
}