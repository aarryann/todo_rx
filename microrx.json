{
  "pages": [
    "board/board.html",
    "signal",
    "jira/index.html"
  ],
  "ignore": [
    "index.html",
    "board/index.html",
    "board/profile.html",
    "todo/todo.html"
  ],
  "assets": [
    { "dist": [ "server.mjs", "node_modules/microrx/dist/csr/microrx@0.2.js", "node_modules/microrx/dist/csr/app.js" ] },
    { "dist/data": [ "src/data/todos.json", "src/data/board.json" ] },
    { "dist/board": [ "src/board/data.json" ] },
    { "dist/jira": [ "src/jira/data.json" ] }
  ],
  "outDir": "dist",
  "srcDir": "src",
  "staticLoaders": {
    "loadTodos": "./src/data/todos.json"
  },
  "components": {
    "board_board_html": {
      "Board": "./src/board/Board.rx.html",
      "Column": "./src/board/Column.rx.html",
      "Card": "./src/board/Card.rx.html",
      "Tag": "./src/board/Tag.rx.html"
    },
    "jira_html": {
      "Sidebar": "./src/jira/Sidebar.rx.html",
      "Main": "./src/jira/Main.rx.html",
      "Header": "./src/jira/Header.rx.html",
      "PropertyPane": "./src/jira/PropertyPane.rx.html"
    },
    "todo_todo_html": {
      "TodoList": "./src/components/TodoList.rx.html",
      "TodoItem": "./src/components/TodoItem.rx.html"
    }
  }
}